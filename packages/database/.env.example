# Database connection for backfill scripts (db:backfill-* in this package).
# This file is committed; copy to .env (gitignored) and adjust for your setup.
#
# Local Docker default:
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
#
# To run against production, override per-invocation rather than editing .env:
#   DATABASE_URL="<prod_url>" pnpm --filter @workspace/database db:backfill-...
